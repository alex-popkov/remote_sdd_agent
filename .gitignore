# Env
.env
.env.local
.env.*.local

# Dependencies
node_modules/
**/node_modules/

# Build output
dist/
build/
**/dist/
**/build/
*.tsbuildinfo

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Coverage
coverage/
*.lcov

# IDE / editor
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
**/.DS_Store
Thumbs.db

# Runtime workspace (queue + per-run repos/artifacts/logs + dedupe state)
# Keep dirs themselves (via .gitkeep) but ignore their contents.
workspace/queue/*/*.json
workspace/runs/*
workspace/state/*.db*
!workspace/**/.gitkeep
