# Copy to .env and fill in real values. Never commit .env.
# Generate the secret with: openssl rand -hex 32

# --- Required ---

# HMAC secret shared with the GitHub App webhook configuration.
GITHUB_WEBHOOK_SECRET=replace-with-openssl-rand-hex-32

# Token used by `git clone` and `gh` CLI (GitHub App installation token or fine-grained PAT).
# Needs: contents:write, issues:write, pull_requests:write on the whitelisted repos.
# Can be a throwaway placeholder for the local smoke test in scripts/smoke-test.sh.
GITHUB_TOKEN=ghp_replace_me

# Anthropic API key for the `claude` CLI. Not used by the receiver — only by the worker pipeline.
# Can be a throwaway placeholder until you reach M4.
ANTHROPIC_API_KEY=sk-ant-replace-me

# Comma-separated `owner/name` whitelist. The receiver drops events from any repo not in this list,
# even when the HMAC signature is valid. Defense in depth if the webhook secret leaks.
ALLOWED_REPOS=me/test

# --- Optional (defaults shown) ---

# Branch the agent clones, works on, and opens PRs against. The verifier sees
# this branch's state. Leave unset to use the repo's default branch (e.g. main).
# BASE_BRANCH=develop

# Label whose addition fires the agent (issues.labeled event).
# TRIGGER_LABEL=agent:run

# Mention string (without leading @) recognized in issue_comment.created bodies.
# BOT_MENTION=remote-agent

# Per-run cost ceiling in USD, enforced between pipeline stages. Run aborts when exceeded.
# MAX_COST_USD=5.00

# Per-stage retry budget inside the SDD pipeline.
# MAX_STAGE_RETRIES=3
